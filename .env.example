# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/susrutha_db
# For MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+sandbox://user:password@cluster.mongodb.net/susrutha_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=susrutha_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Client Domains (Comma Separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://susruthaayurveda.com,https://admin.susruthaayurveda.com

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH=uploads
